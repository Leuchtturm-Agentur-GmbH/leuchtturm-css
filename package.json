{
	"name": "leuchtturm-css",
	"version": "0.0.1",
	"description": "CSS-Framework der Leuchtturm Agentur für die Astro-Sites, angelehnt an ACSS",
	"type": "module",
	"private": true,
	"license": "UNLICENSED",
	"exports": {
		".": "./src/leuchtturm.css",
		"./grundwerte.json": "./src/grundwerte.json",
		"./pruefen": "./src/pruefen.js"
	},
	"files": [
		"src"
	],
	"scripts": {
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"pruefen": "node scripts/pruefen.mjs",
		"check": "npm run format:check && npm run pruefen"
	},
	"devDependencies": {
		"prettier": "3.10.1"
	}
}
